data
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Frontend node_modules + previous build output
node_modules
frontend/dist
frontend/.vite
*.tsbuildinfo
npm-debug.log*

# Secrets & local tooling
.env
.env.*
!.env.example
.claude
.vercel
