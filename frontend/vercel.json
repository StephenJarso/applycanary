{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://applycanary-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://applycanary-production.up.railway.app/health"
    },
    {
      "source": "/((?!assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
