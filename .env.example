# Copy to .env and fill in. Never commit .env.

# --- LLM API (required for scoring + tailoring) ------------------------------
# Provider chain (tried in order until one works):
# 1. xAI Grok - XAI_API_KEY (OpenAI-compatible; grok-4.6 default)
# 2. Gemini (primary) - GEMINI_API_KEY
# 3. OpenRouter (free models) - OPENROUTER_API_KEY
# 4. Groq (generous free tier) - GROQ_API_KEY
# 5. Ollama (local, unlimited) - OLLAMA_HOST (default http://localhost:11434)
XAI_API_KEY=
XAI_TRIAGE_MODEL=grok-4.6
XAI_TAILOR_MODEL=grok-4.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TAILOR_MODEL=gemini-3.5-flash-lite
# 0 = disable chain-of-thought on Gemini thinking models (recommended for
# short JSON scoring/tailoring calls). Higher values enable thinking.
GEMINI_THINKING_BUDGET=0
OPENROUTER_API_KEY=
OPENROUTER_TRIAGE_MODEL=openai/gpt-4o-mini
OPENROUTER_TAILOR_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_TRIAGE_MODEL=llama-3.1-8b-instant
GROQ_TAILOR_MODEL=llama-3.1-8b-instant
OLLAMA_HOST=http://localhost:11434
OLLAMA_TRIAGE_MODEL=llama3.1:8b
OLLAMA_TAILOR_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
MODEL_TRIAGE=claude-haiku-4-5-20251001
MODEL_TAILOR=claude-sonnet-5

# --- Safety gates -----------------------------------------------------------
# Master switch for live application submission. Left false, every submitter
# runs in dry-run: artifacts are built and queued but nothing is ever sent.
# Do not enable until you have reviewed several dry-run outputs end to end.
ENABLE_AUTO_SUBMIT=false
# Hard ceiling on live submissions per rolling 24h, counted across all sources.
DAILY_APPLY_CAP=20
# Minimum total score before a job is eligible for auto-submit at all.
AUTO_SUBMIT_MIN_SCORE=80

# --- GitHub (evidence for CV tailoring; unauthenticated is 60 req/hr) -------
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Email digest ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
# Score at or above which a job triggers an immediate alert instead of waiting
# for the daily digest, so the fast-apply window is not missed.
ALERT_MIN_SCORE=90

# --- Amazon Web Services (all optional, graceful degradation) ------------
# Bedrock adds Claude + Titan-embedding to the LLM provider chain; Polly and
# Transcribe power the voice interview; S3 stores interview audio. Without any
# of these the app still runs (browser speech, local storage, hashing vectors).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Bedrock model IDs; only used when AWS credentials are present.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Titan v2 default output is 1024 dims; the VECTOR columns are 1024.
EMBEDDING_DIMS=1024
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
S3_BUCKET=
S3_PREFIX=applycanary

# --- CockroachDB Cloud operations (MCP server / ccloud CLI) ---------------
# Managed MCP server config for agent access to the cluster (read-only by
# default, full audit logging). Token comes from the Cloud Console.
COCKROACH_MCP_URL=https://cockroachlabs.cloud/api/v2/mcp
COCKROACH_MCP_TOKEN=
# ccloud CLI service-account credentials (`ccloud iam service-account create`)
CCLOUD_API_KEY=
CCLOUD_API_SECRET=

# --- Optional aggregator keys (connectors self-disable when blank) ----------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Poll cadence (minutes) -------------------------------------------------
# Curated company boards are the fast-apply edge, so they get the tight loop.
# Lowering these further risks rate limits and looks like abuse to the boards.
POLL_CURATED_MINUTES=5
POLL_BROAD_MINUTES=30
SCORE_INTERVAL_MINUTES=2

# --- Server ----------------------------------------------------------------
# Binds loopback by default. The dashboard has NO authentication and holds your
# resume, contact details and application history. Do not change this to
# 0.0.0.0 without putting auth in front of it first.
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/applycanary.db
DATA_DIR=./data

# Frontend base URL for redirects.
# In production: "/" (same origin, React frontend served by FastAPI).
# In development: "http://localhost:5173" (Vite dev server).
FRONTEND_BASE_URL=http://localhost:5173/

# Timezone for the daily cron jobs (digest at 08:03, GitHub refresh, expiry).
# Only consulted when running under Docker, where the container would otherwise
# default to UTC. Running directly on your machine uses the system zone.
TZ=Africa/Nairobi
LOG_LEVEL=INFO

# --- Authentication --------------------------------------------------------
# Set AUTH_ENABLED=true or set AUTH_PASSWORD to require authentication.
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
SECRET_KEY=change-this-to-a-secure-random-secret

# Set false to run the web dashboard alone, with no background polling.
# Equivalent to `python run.py --web-only`.
ENABLE_SCHEDULER=true
