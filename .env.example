# Copy to .env and fill in. Never commit .env.

# --- LLM API (required for scoring + tailoring) ------------------------------
# Gemini is the active backend. The Anthropic key and model overrides are kept
# in case you switch back (the Anthropic code in app/llm/client.py is retained,
# commented out).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TAILOR_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
MODEL_TRIAGE=claude-haiku-4-5-20251001
MODEL_TAILOR=claude-sonnet-5

# --- Safety gates -----------------------------------------------------------
# Master switch for live application submission. Left false, every submitter
# runs in dry-run: artifacts are built and queued but nothing is ever sent.
# Do not enable until you have reviewed several dry-run outputs end to end.
ENABLE_AUTO_SUBMIT=false
# Hard ceiling on live submissions per rolling 24h, counted across all sources.
DAILY_APPLY_CAP=20
# Minimum total score before a job is eligible for auto-submit at all.
AUTO_SUBMIT_MIN_SCORE=80

# --- GitHub (evidence for CV tailoring; unauthenticated is 60 req/hr) -------
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Email digest ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
# Score at or above which a job triggers an immediate alert instead of waiting
# for the daily digest, so the fast-apply window is not missed.
ALERT_MIN_SCORE=90

# --- Optional aggregator keys (connectors self-disable when blank) ----------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Poll cadence (minutes) -------------------------------------------------
# Curated company boards are the fast-apply edge, so they get the tight loop.
# Lowering these further risks rate limits and looks like abuse to the boards.
POLL_CURATED_MINUTES=5
POLL_BROAD_MINUTES=30
SCORE_INTERVAL_MINUTES=2

# --- Server ----------------------------------------------------------------
# Binds loopback by default. The dashboard has NO authentication and holds your
# resume, contact details and application history. Do not change this to
# 0.0.0.0 without putting auth in front of it first.
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/applycanary.db
DATA_DIR=./data

# Timezone for the daily cron jobs (digest at 08:03, GitHub refresh, expiry).
# Only consulted when running under Docker, where the container would otherwise
# default to UTC. Running directly on your machine uses the system zone.
TZ=Africa/Nairobi
LOG_LEVEL=INFO

# --- Authentication --------------------------------------------------------
# Set AUTH_ENABLED=true or set AUTH_PASSWORD to require authentication.
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
SECRET_KEY=change-this-to-a-secure-random-secret

# Set false to run the web dashboard alone, with no background polling.
# Equivalent to `python run.py --web-only`.
ENABLE_SCHEDULER=true
